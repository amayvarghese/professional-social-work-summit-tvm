# --- Required ---
# MongoDB connection string. On Vercel use MongoDB Atlas and allow access
# from anywhere (0.0.0.0/0), since serverless functions have no fixed IP.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/kerala-summit

# --- Optional ---
# Public origin used in "Create your own" share text, no trailing slash.
# Leave unset on Vercel: the deployment URL is used automatically.
# NEXT_PUBLIC_APP_URL=https://professional-social-work-summit-tvm.vercel.app
