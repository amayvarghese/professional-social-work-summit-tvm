# --- Required ---
# MongoDB connection string. On Vercel use MongoDB Atlas and allow access
# from anywhere (0.0.0.0/0), since serverless functions have no fixed IP.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/kerala-summit

# --- Optional ---
# Public origin used in WhatsApp share links, no trailing slash.
# Leave unset on Vercel: the deployment URL is detected automatically.
# Set it once you attach a custom domain.
# NEXT_PUBLIC_APP_URL=https://your-domain.com
